{
  "id": "/dash",
  "name": "Fitdata",
  "short_name": "Fitdata",
  "description": "Your Fitbit's sleep, heart rate, HRV and activity on one clear page.",
  "lang": "en",
  "start_url": "/dash",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["health", "fitness"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Day", "url": "/dash", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Trends", "url": "/dash/trends", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": [
    { "src": "/screenshot-narrow.webp", "sizes": "1170x2271", "type": "image/webp", "form_factor": "narrow", "label": "Last night and today at a glance" },
    { "src": "/screenshot-wide.webp", "sizes": "2560x1560", "type": "image/webp", "form_factor": "wide", "label": "A night's sleep stages, heart rate, SpO₂ and HRV on one time axis" }
  ]
