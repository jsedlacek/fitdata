GCP_PROJECT=fitdata-jsedlacek
# Secrets: sm://<name> in GCP_PROJECT (default), or a local file path
# OAUTH_CLIENT=sm://oauth-client
# Users and their data: a local directory or gs://bucket
STORAGE=data
# Refresh tokens: a Cloud KMS key, or plain (unencrypted, local only)
KMS_KEY=plain
# Local dashboard without Google sign-in, as this user (Google Health user ID)
# DEV_USER=<health-user-id>
