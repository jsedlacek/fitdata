GCP_PROJECT=fitdata-jsedlacek
# Secrets: sm://<name> in GCP_PROJECT (default), or a local file path
# OAUTH_CLIENT=sm://oauth-client
# REFRESH_TOKEN=sm://refresh-token
# Local directory or gs://bucket (BigQuery loads need gs://)
STORAGE=gs://fitdata-jsedlacek-raw
BQ_DATASET=fitdata
# Local dashboard without Google sign-in
AUTH_DISABLED=1
